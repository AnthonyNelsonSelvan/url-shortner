<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form method="post" action="/url">
        <h2>URL Shortener</h2>
        <label>Enter URL</label>
        <input type="text" name="url" placeholder="http://example.com">
        <button type="submit">Generate</button>
    </form>
    <% if (locals.id) { %>
     <p>
        http://localhost:3000/url/<%=id%>
     </p>
    <% } %>
    <% if (locals.urls) { %>
        <table border="2">
            <thead>
                <th>index</th>
                <th>shortid</th>
                <th>redirectURL</th>
                <th>no. of times clicked</th>
            </thead>
            <tbody>
                <% urls.forEach((url, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><a href="/url/<%= url.shortURL %>"><%= url.shortURL %></a></td>
                        <td><%= url.redirectUrl %></td>
                        <td><%= url.visitHistory.length %></td>
                    </tr>
                <% }); %>
            </tbody>
            </table>
    <% } %>
</body>
</html>